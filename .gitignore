# Build output
target/

# Cargo lock (library crates; keep for binaries if needed)
Cargo.lock

# Soroban test snapshots (generated by soroban-sdk testutils, not source)
**/test_snapshots/
**/*.snap
**/*.snap.new

# Code coverage reports (generated locally, uploaded to Codecov in CI)
lcov.info
*.profraw
*.profdata
coverage/

# IDE / editor
.vscode/
.idea/
*.iml
*.swp
*.swo
.DS_Store
.DS_Store?

# Generated ABI output (local runs)
abi/

# Stellar CLI local config and deployment state
.stellar/

# Node.js / TypeScript build artifacts and dependencies
node_modules/
dist/
*.js.map
bindings/*/node_modules/
bindings/*/dist/

# Environment secrets
.env
.env.*
!.env.example

# Temporary / scratch files
*.tmp
*.bak
*.orig
