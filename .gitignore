# Build output
target/

# Cargo lock (library crates; keep for binaries if needed)
Cargo.lock

# Soroban / cargo test snapshots
**/test_snapshots/
**/*.snap
**/*.snap.new

# IDE / editor
.vscode/
.idea/
*.iml
*.swp
*.swo
*.orig
.DS_Store
Thumbs.db

# Generated ABI output (local runs)
abi/

# Stellar CLI local config
.stellar/

# Environment secrets
.env
.env.*
!.env.example

# Coverage / profiling artifacts
lcov.info
coverage/
*.profraw
*.profdata

# Node.js (TypeScript bindings)
node_modules/
bindings/*/dist/
bindings/*/node_modules/

# Compiled WASM output (reproducible via build)
*.wasm

# Temporary / OS files
*.tmp
*.bak
*.log
